```config
#
# Target System
#
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

#
# Target Images
#
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_KERNEL_PARTSIZE=128
CONFIG_TARGET_ROOTFS_PARTSIZE=896

CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y

# 不生成额外磁盘格式
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set

#
# Build System
#
# CONFIG_CCACHE is not set
# CONFIG_DEVEL is not set
# CONFIG_AUTOREMOVE is not set

#
# LuCI
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y

CONFIG_PACKAGE_luci-app-accesscontrol=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-ipsec-vpnd=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-onliner=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-wol=y

CONFIG_PACKAGE_luci-theme-argon=y

#
# Firewall / iptables
#
# 当前 LERAN 固件实际使用 legacy firewall/iptables
#
CONFIG_PACKAGE_firewall=y
CONFIG_PACKAGE_iptables=y

CONFIG_PACKAGE_kmod-ipt-core=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y
CONFIG_PACKAGE_kmod-ipt-nat=y

CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-conntrack-extra=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-socket=y
CONFIG_PACKAGE_iptables-mod-iprange=y
CONFIG_PACKAGE_iptables-mod-ipsec=y
CONFIG_PACKAGE_iptables-mod-fullconenat=y

CONFIG_PACKAGE_ipset=y

# firewall4 不使用
# CONFIG_PACKAGE_firewall4 is not set

#
# nftables
#
# 保留 nft 工具，但不让它成为主防火墙
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_nftables-json=y

# 当前 OpenClash/Firewall3 路线不依赖 nft TProxy/offload
# CONFIG_PACKAGE_kmod-nft-tproxy is not set
# CONFIG_PACKAGE_kmod-nft-offload is not set

#
# OpenClash dependencies
#
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y

CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y

CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y

CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y

CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libustream-openssl=y

CONFIG_PACKAGE_unzip=y

#
# OpenClash / TProxy
#
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-socket=y

#
# IPv6
#
# OpenClash 双栈 / IPv6 / TProxy 支持
#
CONFIG_PACKAGE_ipv6helper=y

CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_ip6tables-extra=y
CONFIG_PACKAGE_ip6tables-mod-nat=y

CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-nf-nat6=y
CONFIG_PACKAGE_kmod-nf-conntrack6=y

CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-ipt-conntrack=y

CONFIG_PACKAGE_6in4=y

#
# IPv6 NAT / conntrack
#
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-ipt-nat=y

#
# Network tools
#
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_irqbalance=y

#
# Intel NIC drivers
#
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-ixgbe=y

#
# Filesystems
#
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y

#
# USB
#
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y

#
# Samba4
#
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_wsdd2=y

CONFIG_PACKAGE_libacl=y
CONFIG_PACKAGE_libattr=y

#
# IPSec / strongSwan
#
CONFIG_PACKAGE_strongswan=y

CONFIG_PACKAGE_kmod-crypto-aes=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-gcm=y
CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-rng=y

CONFIG_PACKAGE_iptables-mod-ipsec=y

#
# Storage / Disk
#
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_gptfdisk=y

#
# System utilities
#
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_sysstat=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_iperf3=y

#
# SSH
#
CONFIG_PACKAGE_openssh-sftp-server=y

#
# DDNS
#
CONFIG_PACKAGE_ddns-scripts-cloudflare=y

#
# Kernel / networking helpers
#
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y

#
# IPv4 / IPv6 routing
#
CONFIG_PACKAGE_ip-full=y

#
# Packages intentionally disabled
#
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_kmod-nft-tproxy is not set
# CONFIG_PACKAGE_kmod-nft-offload is not set

#
# 不额外启用物理网卡专用驱动
# ESXi 中实际使用的虚拟网卡应以 VM 配置为准
#

#
# 其他不需要的软件保持默认关闭
#
```
