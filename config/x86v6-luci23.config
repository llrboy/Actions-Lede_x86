#
# LEDE Configuration
# LEDE R26.09.16 / LERANr1-b952adf4
# LuCI openwrt-25.12
#

# ==================== Target System ====================

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

CONFIG_HAS_SUBTARGETS=y
CONFIG_HAS_DEVICES=y

CONFIG_TARGET_BOARD="x86"
CONFIG_TARGET_SUBTARGET="64"
CONFIG_TARGET_PROFILE="DEVICE_generic"
CONFIG_TARGET_ARCH_PACKAGES="x86_64"


# ==================== Firmware Partition ====================

CONFIG_TARGET_KERNEL_PARTSIZE=128
CONFIG_TARGET_ROOTFS_PARTSIZE=896


# ==================== Build Options ====================

# CONFIG_CCACHE is not set
# CONFIG_DEVEL is not set


# ==================== Image Format ====================
#
# x86_64
# Generic
# BIOS / Legacy GRUB
# SquashFS
# GZIP
#

CONFIG_GRUB_IMAGES=y
# CONFIG_GRUB_EFI_IMAGES is not set

CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# Disable EXT4 rootfs
# CONFIG_TARGET_ROOTFS_EXT4FS is not set

# Disable TAR rootfs
# CONFIG_TARGET_ROOTFS_TARGZ is not set

# Disable VM images
# CONFIG_VMDK_IMAGES is not set
# CONFIG_VDI_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set


# ==================== LuCI ====================

CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-compat=y

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y


# ==================== LuCI Applications ====================

CONFIG_PACKAGE_luci-app-accesscontrol=y
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-ipsec-vpnd=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-onliner=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-wol=y


# ==================== LuCI Chinese Language Packs ====================

CONFIG_PACKAGE_luci-i18n-accesscontrol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-diskman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ipsec-vpnd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-openclash-zh-cn=y
CONFIG_PACKAGE_luci-i18n-samba4-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y


# ==================== TurboACC Disabled ====================

# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_TURBOACC_FLOW_OFFLOADING is not set
# CONFIG_TURBOACC_INCLUDE_BBR_CCA is not set
# CONFIG_TURBOACC_INCLUDE_DNS_FORWARDER is not set
# CONFIG_TURBOACC_INCLUDE_FULLCONENAT is not set
# CONFIG_TURBOACC_INCLUDE_NFT_FULLCONENAT is not set
# CONFIG_TURBOACC_INCLUDE_SHORTCUT_FE is not set
# CONFIG_TURBOACC_INCLUDE_SHORTCUT_FE_DRV is not set


# ==================== DNS ====================

# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y


# ==================== OpenClash Dependencies ====================

CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_tar=y
CONFIG_PACKAGE_unzip=y

CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y

CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y

CONFIG_PACKAGE_iptables=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_iptables-mod-extra=y

CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-extra=y

CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-sockets=y

CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-inet-diag=y

CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y

CONFIG_PACKAGE_libustream-openssl=y

CONFIG_PACKAGE_ip6tables-mod-nat=y

CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y

CONFIG_PACKAGE_jsonfilter=y


# ==================== Network Performance ====================

CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_ethtool=y


# ==================== Intel Ethernet Drivers ====================

CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-ixgbe=y


# ==================== Filesystem ====================

CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y


# ==================== USB Storage ====================

CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y


# ==================== Samba4 ====================

CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_wsdd2=y


# ==================== IPSec Kernel ====================

CONFIG_PACKAGE_kmod-crypto-aes=y
CONFIG_PACKAGE_kmod-crypto-sha1=y
CONFIG_PACKAGE_kmod-crypto-sha256=y
CONFIG_PACKAGE_kmod-crypto-gcm=y

CONFIG_PACKAGE_kmod-ipsec=y
CONFIG_PACKAGE_kmod-ipsec4=y
CONFIG_PACKAGE_kmod-ipsec6=y

CONFIG_PACKAGE_kmod-ipt-ipsec=y
CONFIG_PACKAGE_kmod-xfrm-interface=y


# ==================== strongSwan ====================
#
# Do NOT use strongswan-default/minimal meta packages.
# Explicitly select required components.
#

CONFIG_PACKAGE_strongswan=y
CONFIG_PACKAGE_strongswan-charon=y
CONFIG_PACKAGE_strongswan-ipsec=y
CONFIG_PACKAGE_strongswan-pki=y
CONFIG_PACKAGE_strongswan-swanctl=y
CONFIG_PACKAGE_strongswan-libtls=y

# EAP-MSCHAPv2 is considered insecure by current strongSwan packaging
CONFIG_STRONGSWAN_INCLUDE_INSECURE=y


# ==================== strongSwan Core Plugins ====================

CONFIG_PACKAGE_strongswan-mod-kernel-netlink=y
CONFIG_PACKAGE_strongswan-mod-socket-default=y

CONFIG_PACKAGE_strongswan-mod-aes=y
CONFIG_PACKAGE_strongswan-mod-des=y
CONFIG_PACKAGE_strongswan-mod-gmp=y
CONFIG_PACKAGE_strongswan-mod-hmac=y
CONFIG_PACKAGE_strongswan-mod-md4=y
CONFIG_PACKAGE_strongswan-mod-md5=y
CONFIG_PACKAGE_strongswan-mod-openssl=y
CONFIG_PACKAGE_strongswan-mod-random=y
CONFIG_PACKAGE_strongswan-mod-sha1=y
CONFIG_PACKAGE_strongswan-mod-sha2=y

CONFIG_PACKAGE_strongswan-mod-mgf1=y
CONFIG_PACKAGE_strongswan-mod-pubkey=y
CONFIG_PACKAGE_strongswan-mod-x509=y
CONFIG_PACKAGE_strongswan-mod-pem=y
CONFIG_PACKAGE_strongswan-mod-pkcs1=y


# ==================== strongSwan EAP ====================

CONFIG_PACKAGE_strongswan-mod-eap-identity=y
CONFIG_PACKAGE_strongswan-mod-eap-mschapv2=y
CONFIG_PACKAGE_strongswan-mod-eap-tls=y


# ==================== strongSwan Legacy / Compatibility ====================

CONFIG_PACKAGE_strongswan-mod-eap-md5=y
CONFIG_PACKAGE_strongswan-mod-xauth-generic=y


# ==================== strongSwan Backend ====================

CONFIG_PACKAGE_strongswan-mod-vici=y


# ==================== strongSwan Firewall / XFRM ====================

CONFIG_PACKAGE_strongswan-mod-updown=y


# ==================== Disable strongSwan Meta Packages ====================

# CONFIG_PACKAGE_strongswan-default is not set
# CONFIG_PACKAGE_strongswan-minimal is not set


# ==================== Optional strongSwan Components ====================

# Not required for the selected setup:
# CONFIG_PACKAGE_strongswan-mod-kernel-libipsec is not set
# CONFIG_PACKAGE_strongswan-mod-socket-dynamic is not set
# CONFIG_PACKAGE_strongswan-mod-eap-radius is not set
# CONFIG_PACKAGE_strongswan-mod-sql is not set
# CONFIG_PACKAGE_strongswan-mod-sqlite is not set
# CONFIG_PACKAGE_strongswan-mod-ldap is not set
# CONFIG_PACKAGE_strongswan-mod-gcrypt is not set
# CONFIG_PACKAGE_strongswan-mod-wolfssl is not set
# CONFIG_PACKAGE_strongswan-mod-curve25519 is not set


# ==================== End ====================
